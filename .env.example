# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used to build the guest guide links sent by email
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=conciergerie@votre-domaine.fr

# Anthropic (assistant IA du locataire, §21)
ANTHROPIC_API_KEY=
# Optionnel — par défaut claude-sonnet-5 (voir lib/ai/assistant.ts)
ANTHROPIC_MODEL=

# Shared secret required in the Authorization header of the cron routes
# (Vercel Cron sends this automatically when CRON_SECRET is set on the project)
CRON_SECRET=
